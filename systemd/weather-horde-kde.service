[Unit]
Description=Weather Horde KDE preview-only controller
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/projects/weather-horde-kde
ExecStart=/usr/bin/python3 %h/projects/weather-horde-kde/weather_controller.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=graphical-session.target
