[Unit]
Description=Weather Horde KDE preview-only controller
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Example only: replace @REPO@ with your absolute reviewed checkout.
# Prefer scripts/install-controller-service.py, which generates the actual unit.
WorkingDirectory=@REPO@
ExecStart=/usr/bin/python3 @REPO@/weather_controller.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=graphical-session.target
