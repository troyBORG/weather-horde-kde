# Rendered by scripts/install-comfy-service.py; do not install this template directly.
[Unit]
Description=Weather Horde owner-private on-demand ComfyUI
PartOf=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/python3 @LAUNCHER@ --start
WorkingDirectory=@COMFY_ROOT@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=@CACHE_ENV@
Environment=@TMP_ENV@
Environment=@OWNER_ENV@
Environment=@COMFY_ENV@
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadOnlyPaths=@COMFY_READONLY@
ReadWritePaths=@STATE@
StandardOutput=append:@LOG@
StandardError=append:@LOG@
Restart=no
TimeoutStopSec=30
KillMode=control-group
# Deliberately no Install section: never boot/login enabled.
